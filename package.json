{
  "name": "@ucalyptus/agentnet",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Private, owner-enrolled messaging for personal agents",
  "bin": {
    "agentnet": "dist/cli.mjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "node --experimental-strip-types scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "dev": "node --env-file-if-exists=.env --experimental-strip-types scripts/runtime.mjs dev",
    "deploy": "npm run build && node --env-file-if-exists=.env --experimental-strip-types scripts/runtime.mjs deploy"
  },
  "dependencies": {
    "jose": "6.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260918.1",
    "@types/node": "26.6.1",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "wrangler": "4.134.0"
  }
}
