{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ucalyptus-agentnet",
  "main": "src/worker.ts",
  "account_id": "9826964d1a9d241e9d1a1af2fd151d40",
  "compatibility_date": "2026-09-17",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "net.ucalyptus.me", "custom_domain": true }],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "NETWORK", "class_name": "Network" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Network"] }],
  // The daily rows-written ceiling the object holds itself to. 100000 is the Workers
  // Free plan limit; set "0" on a paid plan to disable the self-imposed brake.
  "vars": { "ROWS_WRITTEN_LIMIT": "100000" },
  // An uncaught fault used to be visible only as an exception count on the dashboard.
  // The Worker logs its own cause now, which is worthless unless this is on.
  "observability": { "enabled": true, "head_sampling_rate": 1 }
}
